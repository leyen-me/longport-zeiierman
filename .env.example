# 长桥 OpenAPI 凭证 (https://open.longportapp.com/account/my-api)
LONGPORT_APP_KEY=
LONGPORT_APP_SECRET=
LONGPORT_ACCESS_TOKEN=

# 可选: 覆盖 API 端点 (国内网络直连可尝试 openapi.longbridgeapp.com)
# LONGPORT_HTTP_URL=https://openapi.longportapp.com
# LONGPORT_QUOTE_WS_URL=wss://openapi-quote.longportapp.com
# LONGPORT_TRADE_WS_URL=wss://openapi-trade.longportapp.com

# QQ 邮箱通知 (交易信号 + 大乐透对奖共用同一套配置)
# 授权码获取: QQ邮箱 -> 设置 -> 账户 -> 开启 SMTP 服务 -> 生成授权码 (不是登录密码)
MSG_SMTP_USERNAME=你的QQ号@qq.com
MSG_SMTP_PASSWORD=SMTP授权码
# 收件邮箱, 默认发给发件邮箱自身
QQ_NOTIFY_TO=
ENABLE_EMAIL_MSG=true

# 可选: 大乐透开奖数据源代理 (官方接口对海外/机房 IP 封锁返回 567, 会自动回退 500.com;
# 若想强制走官方源, 配置一个国内代理)
# LOTTERY_HTTP_PROXY=http://user:pass@host:port
