//@version=6
// ZTP 调试指标: 把策略内部指标值全部输出到 Data Window, 用于导出与 Python 逐 bar 比对
// 用法: 加到 SPY 2分钟图(与策略相同参数) -> 右键图表 -> Export chart data -> 保存CSV
indicator("ZTP Debug Plots", shorttitle="ZTP-DBG", overlay=false, max_labels_count=500)

fl=input.int(21,"Pulse Range"), pl=input.int(9,"Pulse Stochastic"), ps=input.int(7,"Pulse Smoothing")
sl=input.int(55,"Trend Range"), ml=input.int(120,"Macro Trend"), ts=input.int(5,"Trend Smoothing")
db=input.float(9.0,"Trend Persistence")
zn=input.int(20,"Exhaustion Zone"), sn=input.int(7,"Sensitivity")
pullEmaLen=input.int(12,"回调 EMA"), atrLen=input.int(14,"ATR 周期")

const float sw=0.18
const float mw=0.72
const float th=0.92

var float ud=0.0
var float dd=0.0
var float tz=na

clp(float v,float lo,float hi)=>math.max(lo,math.min(hi,v))
sm(float v,int k)=>k>1?ta.ema(v,k):v

wr(int k)=>
    hh=ta.highest(high,k)
    ll=ta.lowest(low,k)
    100.0*(close-hh)/math.max(hh-ll,syminfo.mintick)

eff(int k)=>
    p=ta.sma(math.abs(close-close[1]),k)*k
    n=na(close[k])?na:math.abs(close-close[k])
    na(p) or na(n)?na:clp(n/math.max(p,syminfo.mintick),0.0,1.0)

stk(float x,int k)=>
    hi=ta.highest(x,k)
    lo=ta.lowest(x,k)
    -100.0+100.0*(x-lo)/math.max(hi-lo,1e-10)

con(array<float> a,array<float> w)=>
    ws0=w.get(0)+w.get(1)+w.get(2)
    clp((a.get(0)*w.get(0)+a.get(1)*w.get(1)+a.get(2)*w.get(2))/math.max(ws0,1e-10),-100.0,0.0)

agr(array<float> a)=>
    d=math.abs(a.get(0)-a.get(1))+math.abs(a.get(1)-a.get(2))+math.abs(a.get(0)-a.get(2))
    1.0-clp(d/300.0,0.0,1.0)

alpha(float prev,float trg,float mac,float agI,float efI,float base,float hold)=>
    side=mac>-50.0?1:mac<-50.0?-1:0
    pull=(side==1 and trg<prev) or (side==-1 and trg>prev)
    lk=clp(0.15+agI*efI*hold,0.0,0.97)
    pull?math.max(0.015,base*(1.0-lk)):math.max(base*0.75,0.03)

array<float> rz=array.from(wr(fl),wr(sl),wr(ml))
rf=rz.get(0)
rp=stk(rf,pl)
pr=clp(rf*0.72+rp*0.28,-100.0,0.0)
pz=sm(pr,ps)

fw=math.max(0.0,1.0-sw-mw)
array<float> twt=array.from(fw,sw,mw)
cn=con(rz,twt)
ag=agr(rz)
ef=nz(eff(sl),0.0)

ud:=cn>-30.0?math.min(1.0,nz(ud[1])*0.93+0.07):nz(ud[1])*0.94
dd:=cn<-70.0?math.min(1.0,nz(dd[1])*0.93+0.07):nz(dd[1])*0.94

tg0=clp(cn+db*(ud-dd),-100.0,0.0)
tg=sm(tg0,2)

ba=2.0/(ts+1.0)
pa=na(tz[1])?ba:alpha(tz[1],tg,rz.get(2),ag,ef,ba,th)
tz:=na(tz[1])?tg:clp(tz[1]+pa*(tg-tz[1]),-100.0,0.0)

d=float(sn-5)
ez=clp(float(zn)-d*4.0,8.0,42.0)
rb=clp(8.0+d*1.75,1.0,18.0)
cf=sn<=5?1:sn<=7?2:sn<=9?3:4
fastExit=sn<=2

up=-ez
dn=-100.0+ez
ur=up-rb
lr=dn+rb

uc=pz>=up and tz>=up
lc=pz<=dn and tz<=dn

var int ucn=0
var int lcn=0
var int est=0
ucn:=uc?ucn+1:0
lcn:=lc?lcn+1:0

if est==0
    if ucn>=cf
        est:=1
    else if lcn>=cf
        est:=-1
else if est==1 and (fastExit?(pz<ur or tz<ur):(pz<ur and tz<ur))
    est:=0
else if est==-1 and (fastExit?(pz>lr or tz>lr):(pz>lr and tz>lr))
    est:=0

xup=ta.crossover(pz,tz)
xdn=ta.crossunder(pz,tz)

emaPb=ta.ema(close,pullEmaLen)
atrV=ta.atr(atrLen)

plot(pz, "pz", display=display.data_window)
plot(tz, "tz", display=display.data_window)
plot(xup?1:0, "xup", display=display.data_window)
plot(xdn?1:0, "xdn", display=display.data_window)
plot(est, "est", display=display.data_window)
plot(emaPb, "ema12", display=display.data_window)
plot(atrV, "atr14", display=display.data_window)
plot(close, "close", display=display.data_window)
